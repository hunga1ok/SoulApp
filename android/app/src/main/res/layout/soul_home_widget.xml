<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/soul_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_soul_widget_plum"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/soul_widget_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:singleLine="true"
        android:text="SOUL • TẦM NHÌN"
        android:textAllCaps="true"
        android:textColor="#E8D2E1"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/soul_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="A Little World Where You Feel Safe"
        android:textColor="#FFF9F5"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/soul_widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="center_vertical"
        android:lineSpacingMultiplier="1.18"
        android:maxLines="3"
        android:text="Mỗi ngày của tôi được lấp đầy bởi sự bình an, lòng biết ơn và những điều dịu dàng."
        android:textColor="#FFF9F5"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/soul_widget_player_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:background="#2EFFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/soul_widget_play_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Play"
            android:src="@android:drawable/ic_media_play" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/soul_widget_music_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFF9F5"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/soul_widget_music_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#D9C0D1"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/soul_widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Chạm để mở Soul ✦"
        android:textColor="#D9C0D1"
        android:textSize="11sp" />
</LinearLayout>
