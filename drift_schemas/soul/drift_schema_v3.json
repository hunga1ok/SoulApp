  "fixed_sql": [
    {
      "name": "user_journeys",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_journeys\" (\"id\" TEXT NOT NULL, \"journey_code\" TEXT NOT NULL, \"locale\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"started_on\" TEXT NOT NULL, \"timezone\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "reminder_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminder_preferences\" (\"kind\" TEXT NOT NULL, \"enabled\" INTEGER NOT NULL CHECK (\"enabled\" IN (0, 1)), \"minute_of_day\" INTEGER NULL, \"timezone\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"kind\"), CHECK (NOT enabled OR minute_of_day IS NOT NULL));"
        }
      ]
    },
    {
      "name": "visions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"visions\" (\"id\" TEXT NOT NULL, \"category_code\" TEXT NOT NULL, \"statement\" TEXT NOT NULL, \"image_path\" TEXT NULL, \"locale\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"archived_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "vision_feelings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vision_feelings\" (\"vision_id\" TEXT NOT NULL REFERENCES visions (id) ON DELETE CASCADE, \"feeling_code\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"vision_id\", \"feeling_code\"), UNIQUE (\"vision_id\", \"position\"), CHECK (position BETWEEN 1 AND 3));"
        }
      ]
    },
    {
      "name": "vision_answers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vision_answers\" (\"vision_id\" TEXT NOT NULL REFERENCES visions (id) ON DELETE CASCADE, \"question_code\" TEXT NOT NULL, \"value_codes\" TEXT NOT NULL, \"custom_text\" TEXT NULL, PRIMARY KEY (\"vision_id\", \"question_code\"));"
        }
      ]
    },
    {
      "name": "gratitude_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"gratitude_entries\" (\"id\" TEXT NOT NULL, \"user_journey_id\" TEXT NULL REFERENCES user_journeys (id) ON DELETE SET NULL, \"journey_day\" INTEGER NULL, \"gratitude_text\" TEXT NOT NULL, \"reason_text\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "user_journeys_one_active",
